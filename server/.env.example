#
# 이 파일을 .env 로 복사한 뒤 실제 키를 채우세요:  cp .env.example .env
# .env 는 .gitignore 로 제외되며 절대 커밋하지 마세요. 키는 서버에만 둡니다.

# Anthropic API 키 (형식: sk-ant-...). 서버 측에서만 사용합니다.
ANTHROPIC_API_KEY=sk-ant-...

# 프록시 포트 (기본 8787)
PORT=8787

# --- 선택: 비용/품질 조정 (미설정 시 비용우선 기본값) ---
# 모델(비용우선 기본 claude-haiku-4-5). 품질 상향: claude-sonnet-5 또는 claude-opus-5
# AI_MODEL=claude-haiku-4-5
# 태스크별 출력 토큰 상한 (기본 700)
# AI_MAX_TOKENS=700
# 비-Haiku 모델의 추론 강도 (기본 low)
# AI_EFFORT=low
# IP별 분당 요청 제한 (기본 20)
# AI_RATE_LIMIT_PER_MIN=20
# 월간 토큰 예산 (기본 2000000). 초과 시 429 {fallback:true}
# AI_MONTHLY_TOKEN_CAP=2000000
